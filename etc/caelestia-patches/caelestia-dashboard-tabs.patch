diff --color -ruN a/modules/dashboard/Content.qml b/modules/dashboard/Content.qml
--- a/modules/dashboard/Content.qml	2026-11-03 23:15:54.443238352 +0200
+++ b/modules/dashboard/Content.qml	2026-11-03 23:16:10.350009375 +0200
@@ -52,6 +52,22 @@
     implicitWidth: nonAnimWidth
     implicitHeight: nonAnimHeight
 
+    // Switch tabs with arrow keys
+    focus: true
+    Keys.onLeftPressed: root.screenState.dashboardTab = Math.max(root.screenState.dashboardTab - 1, 0)
+    Keys.onRightPressed: root.screenState.dashboardTab = Math.min(root.screenState.dashboardTab + 1, tabs.count - 1)
+    Keys.onEscapePressed: root.screenState.dashboard = false
+    Component.onCompleted: forceActiveFocus()
+
+    Connections {
+        function onDashboardChanged(): void {
+            if (root.screenState.dashboard)
+                root.forceActiveFocus();
+        }
+
+        target: root.screenState
+    }
+
     Tabs {
         id: tabs
 
diff --color -ruN a/modules/dashboard/Tabs.qml b/modules/dashboard/Tabs.qml
--- a/modules/dashboard/Tabs.qml	2026-11-03 23:15:54.443514015 +0200
+++ b/modules/dashboard/Tabs.qml	2026-11-03 23:16:10.349848601 +0200
@@ -28,8 +28,20 @@
         anchors.top: parent.top
         anchors.topMargin: Tokens.sizes.dashboard.tabIndicatorSpacing
 
+        // Remember last tab: TabBar resets currentIndex to 0 while its tabs are
+        // being created, so only write back once the saved tab is restored
+        property bool restored: false
+
         currentIndex: root.screenState.dashboardTab
-        onCurrentIndexChanged: root.screenState.dashboardTab = currentIndex
+        onCurrentIndexChanged: {
+            if (restored)
+                root.screenState.dashboardTab = currentIndex;
+        }
+        Component.onCompleted: Qt.callLater(() => {
+            root.screenState.dashboardTab = Math.max(0, Math.min(root.screenState.dashboardTab, count - 1));
+            currentIndex = Qt.binding(() => root.screenState.dashboardTab);
+            restored = true;
+        })
 
         implicitHeight: contentHeight
         background: null
