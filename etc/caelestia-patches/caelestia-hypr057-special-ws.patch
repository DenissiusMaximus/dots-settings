# Fix special workspaces (scratchpads) in the caelestia bar on Hyprland 0.57
# (caelestia-dots/shell#2235, based on https://gist.github.com/romanvesely/ad4c7e41b3cac561ff06b44c62501d2b)
# + fixed slots 1..5 in order (1 = "special", then special:2..special:5).
diff -ru a/modules/bar/components/workspaces/SpecialWorkspaces.qml b/modules/bar/components/workspaces/SpecialWorkspaces.qml
--- a/modules/bar/components/workspaces/SpecialWorkspaces.qml
+++ b/modules/bar/components/workspaces/SpecialWorkspaces.qml
@@ -15,10 +15,24 @@
 
     required property HyprlandMonitor monitor
 
-    readonly property int activeSpecialId: monitor?.lastIpcObject.specialWorkspace?.id ?? 0
+    readonly property int activeSpecialId: Hypr.specialWsId(monitor?.lastIpcObject.specialWorkspace?.name ?? "")
     readonly property var wsIds: {
         const allMonitors = !Config.bar.workspaces.perMonitor;
-        return Hypr.workspaces.values.filter(w => w.name.startsWith("special:") && (allMonitors || w.monitor === root.monitor)).map(w => w.id);
+        const shown = Math.max(1, Config.bar.workspaces.shown);
+        const ids = [];
+        for (let n = 1; n <= shown; n++)
+            ids.push(Hypr.specialWsId(Hypr.specialSlotName(n)));
+        // keep the active one visible even if it is beyond the fixed slots
+        if (activeSpecialId !== 0 && !ids.includes(activeSpecialId))
+            ids.push(activeSpecialId);
+        for (const w of Hypr.workspaces.values) {
+            if (!w.name.startsWith("special:") || !(allMonitors || w.monitor === root.monitor))
+                continue;
+            const id = Hypr.wsId(w);
+            if (!ids.includes(id))
+                ids.push(id);
+        }
+        return ids;
     }
     readonly property int activeIdx: wsIds.indexOf(activeSpecialId)
     readonly property real maxViewY: Math.max(0, view.contentHeight - height)
@@ -223,9 +237,9 @@
 
             const ws = view.itemAt(event.x, event.y - view.y) as Workspace;
             if (ws) {
-                const match = Hypr.workspaces.values.find(w => w.id === ws.ws);
