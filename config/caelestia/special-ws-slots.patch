diff --color -ru a/services/Hypr.qml b/services/Hypr.qml
--- a/services/Hypr.qml	2026-11-03 22:20:30.165637990 +0200
+++ b/services/Hypr.qml	2026-11-03 22:20:44.395463621 +0200
@@ -114,6 +114,22 @@
         return -1000 - hash;
     }
 
+    // local patch: fixed scratchpad slots shown in the bar, like numbered workspaces
+    // (slot 1 = the main "special", then special:2, special:3, ...)
+    function specialSlotName(n: int): string {
+        return n === 1 ? "special:special" : `special:${n}`;
+    }
+
+    function specialWsName(id: int): string {
+        for (let n = 1; n <= 10; n++) {
+            const name = specialSlotName(n);
+            if (specialWsId(name) === id)
+                return name;
+        }
+        const ws = workspaces.values.find(w => w.name.startsWith("special:") && specialWsId(w.name) === id);
+        return ws ? ws.name : "";
+    }
+
     function toplevelsForWs(ws: int, ignoredTags = []): list<HyprlandToplevel> {
         return toplevels.values.filter(t => t.workspace && wsId(t.workspace) === ws && !isToplevelIgnored(t, ignoredTags));
     }
