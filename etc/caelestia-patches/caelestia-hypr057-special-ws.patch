+    // local patch: since Hyprland 0.57 special workspaces have no numeric id (Quickshell reports -1
+    // for all of them), so they get a stable negative one derived from their name
+    function wsId(ws: HyprlandWorkspace): int {
+        if (!ws)
+            return 0;
+        return ws.name.startsWith("special:") ? specialWsId(ws.name) : ws.id;
+    }
+
+    function specialWsId(name: string): int {
+        if (!name)
+            return 0;
+        let hash = 0;
+        for (let i = 0; i < name.length; i++)
+            hash = (hash * 31 + name.charCodeAt(i)) % 1000000;
+        return -1000 - hash;
+    }
+
+    // local patch: fixed scratchpad slots shown in the bar, like numbered workspaces
+    // (slot 1 = the main "special", then special:2, special:3, ...)
+    function specialSlotName(n: int): string {
+        return n === 1 ? "special:special" : `special:${n}`;
+    }
+
+    function specialWsName(id: int): string {
+        for (let n = 1; n <= 10; n++) {
+            const name = specialSlotName(n);
+            if (specialWsId(name) === id)
+                return name;
+        }
+        const ws = workspaces.values.find(w => w.name.startsWith("special:") && specialWsId(w.name) === id);
+        return ws ? ws.name : "";
+    }
+
     function toplevelsForWs(ws: int, ignoredTags = []): list<HyprlandToplevel> {
-        return toplevels.values.filter(t => t.workspace && t.workspace.id === ws && !isToplevelIgnored(t, ignoredTags));
+        return toplevels.values.filter(t => t.workspace && wsId(t.workspace) === ws && !isToplevelIgnored(t, ignoredTags));
     }
 
     function isToplevelIgnored(toplevel: HyprlandToplevel, ignoredTags = []): bool {
